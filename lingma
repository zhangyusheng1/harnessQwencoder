#!/bin/bash
# 真实的 Lingma CLI 工具 - Bash 包装器

# 构建环境变量字符串
ENV_VARS=""

# 从 .env 文件中提取 API key
if [ -f ".env" ]; then
    # 优先提取 DASHSCOPE_API_KEY（官方推荐）
    DASHSCOPE_API_KEY=$(grep "^DASHSCOPE_API_KEY=" .env | cut -d'=' -f2- | tr -d '"')
    if [ -n "$DASHSCOPE_API_KEY" ]; then
        ENV_VARS="DASHSCOPE_API_KEY=$DASHSCOPE_API_KEY"
    else
        # 回退到 LINGMA_API_KEY
        LINGMA_API_KEY=$(grep "^LINGMA_API_KEY=" .env | cut -d'=' -f2- | tr -d '"')
        if [ -n "$LINGMA_API_KEY" ]; then
            ENV_VARS="LINGMA_API_KEY=$LINGMA_API_KEY"
        fi
    fi
fi

# 调用 Python 脚本，传递环境变量（使用 python 而不是 python3，Windows 兼容）
if [ -n "$ENV_VARS" ]; then
    env $ENV_VARS python "$(dirname "$0")/lingma-real.py" "$@"
else
    python "$(dirname "$0")/lingma-real.py" "$@"
fi